.github/workflow/monthly.yml
/name: Update quotes bulanan
on:
  schedule:
    - cron: "0 1 1 * *"
  workflow_dispatch:
permissions:
  contents: write
jobs:
  update:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - run: python3 scripts/generate.py
        env:
          ANTHROPIC_API_KEY: ${{ secrets.ANTHROPIC_API_KEY }}
      - run: |
          git config user.name "quotes-bot"
          git config user.email "bot@users.noreply.github.com"
          git add quotes.json
          git diff --cached --quiet || (git commit -m "Update quotes bulanan" && git push)
